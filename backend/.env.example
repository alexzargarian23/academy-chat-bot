DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/concierge_db
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=your_supported_gemini_model
GEMINI_FALLBACK_MODEL=
RAG_MIN_SIMILARITY=0.55
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile

# Academy mailbox (IMAP/SMTP). Use a dedicated mailbox and app password/OAuth bridge.
ACADEMY_EMAIL_USER=admissions@example.edu
ACADEMY_EMAIL_PASSWORD=replace-with-mailbox-secret
ACADEMY_EMAIL_FROM=admissions@example.edu
ACADEMY_IMAP_HOST=imap.example.edu
ACADEMY_IMAP_PORT=993
ACADEMY_IMAP_MAILBOX=INBOX
ACADEMY_SMTP_HOST=smtp.example.edu
ACADEMY_SMTP_PORT=465
ACADEMY_SMTP_USE_SSL=true

# Telegram Bot API
TELEGRAM_BOT_TOKEN=replace-with-telegram-bot-token
TELEGRAM_WEBHOOK_SECRET=generate-a-long-random-secret

# Slack Events API
SLACK_BOT_TOKEN=xoxb-replace-with-slack-bot-token
SLACK_SIGNING_SECRET=replace-with-slack-signing-secret
# The Slack app must include the users:read.email OAuth scope so users.info
# can return a verified email for role-based Academy access.
